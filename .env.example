# ==============================================================================
# LLM API Integration Configuration
# ==============================================================================

# LLM Provider selection: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (optional, if using OpenAI: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Context Window Management Strategy
# Options:
#   - "sliding_window" (truncates to last MAX_HISTORY_MESSAGES)
#   - "summarization"  (summarizes evicted older turns into running memory)
CONTEXT_STRATEGY=summarization

# Maximum number of recent conversational messages to keep in active context window
# (6 messages = 3 user/assistant turns)
MAX_HISTORY_MESSAGES=6

# Server configuration
PORT=8000
HOST=127.0.0.1
